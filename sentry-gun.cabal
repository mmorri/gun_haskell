cabal-version:       2.2

name:                sentry-gun
version:             0.1.0.0
-- synopsis:
-- description:
homepage:            https://github.com/githubuser/sentry-gun#readme
license:             BSD-3-Clause
license-file:        LICENSE
author:              Author name here
maintainer:          example@example.com
copyright:           2025 Author name here
category:            Web
build-type:          Simple
extra-source-files:  README.md
                      CHANGELOG.md
                      assets/kenney/*.png
                      assets/kenney/License-CC0-Kenney.txt

executable sentry-gun
  hs-source-dirs:      src
  main-is:             Main.hs
  default-language:    Haskell2010
  build-depends:       base >= 4.7 && < 5,
                       containers,
                       ansi-terminal,
                       gloss >= 1.13,
                       gloss-juicy
  other-modules:       Enemy, Gun, Game, ConsoleUI, Render, Bullet, Assets
  ghc-options:         -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-record-updates
                       -Wincomplete-uni-patterns
                       -Wmissing-export-lists
                       -Wmissing-home-modules
                       -Wpartial-fields
                       -Wredundant-constraints
                       -optl-fuse-ld=bfd

source-repository head
  type:     git
  location: https://github.com/githubuser/sentry-gun
